# Copie para .env (local) ou cadastre como variáveis de ambiente no provedor de hospedagem.
# As variáveis VITE_ são embutidas no build: refaça o build após alterá-las.

# Endpoint do formulário Formspree (https://formspree.io > New form > Integration).
# Sem um endpoint válido, a página de contato mostra o aviso "formulário indisponível"
# e desativa o envio, em vez de fingir que a mensagem foi enviada.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/SEU_FORM_ID

# E-mail comercial exibido no rodapé, na página de contato e na política de privacidade.
# Deixe vazio até o domínio e a caixa de e-mail existirem de verdade.
VITE_CONTACT_EMAIL=
